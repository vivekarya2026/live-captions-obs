<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Live Captions @VERSION@</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <license file="LICENSE.txt"/>
  <options customize="never" require-scripts="false" hostArchitectures="@ARCH@"/>
  <domains enable_localSystem="true"/>
  <volume-check>
    <allowed-os-versions><os-version min="12.0"/></allowed-os-versions>
  </volume-check>
  <choices-outline>
    <line choice="default"><line choice="org.livecaptions.obs"/></line>
  </choices-outline>
  <choice id="default"/>
  <choice id="org.livecaptions.obs" visible="false">
    <pkg-ref id="org.livecaptions.obs"/>
  </choice>
  <pkg-ref id="org.livecaptions.obs" version="@VERSION@" onConclusion="none">LiveCaptions.pkg</pkg-ref>
</installer-gui-script>
